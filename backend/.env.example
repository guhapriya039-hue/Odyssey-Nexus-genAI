# ---- Runtime -------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ---- Storage -------------------------------------------------------------
# SQLite for the prototype. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://odyssey:odyssey@db:5432/odyssey
DATABASE_URL=sqlite:///./odyssey.db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=41943040
RETENTION_DAYS=90

# Comma-separated. Add your dashboard origin when deploying.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---- LLM (optional) ------------------------------------------------------
# Any OpenAI-compatible endpoint. Leave empty to run in deterministic
# extractive mode (no network required, still fully source-grounded).
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_FALLBACK_MODELS=gpt-4o-mini,llama-3.3-70b-versatile
# Ollama on a private host:
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=llama3.1
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1400

# ---- Embeddings ----------------------------------------------------------
# auto | local | st | api
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=512

# ---- Retrieval and chunking ---------------------------------------------
CHUNK_TARGET_CHARS=1100
CHUNK_OVERLAP_CHARS=180
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.12
RETRIEVAL_MAX_CONTEXT_CHARS=9000

# ---- Guardrails ----------------------------------------------------------
INJECTION_BLOCK_THRESHOLD=0.45
PII_REDACTION=true
GROUNDING_MIN_SCORE=0.55
NUMERIC_GROUNDING=true

# ---- Multimodal capability flags ----------------------------------------
OCR_ENABLED=true
SPEECH_TO_TEXT_ENABLED=true
ALLOW_WEB_INGESTION=true
# Keep false in any shared or cloud deployment (SSRF protection).
ALLOW_PRIVATE_NETWORK_FETCH=false
